{
  "ConnectionStrings": {
    // SQLite 单文件库。相对路径由 Program.cs 统一锚定到 ContentRootPath，
    // 避免从不同工作目录启动时把 KeKe.db 散落到别处。
    // Default Timeout = 等锁的秒数（SQLite 是库级写锁，默认等不到就抛 database is locked）。
    // Foreign Keys = True 显式打开外键约束，对齐 SQL Server 的行为。
    "DefaultConnection": "Data Source=KeKe.db;Default Timeout=30;Foreign Keys=True"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "cs",
    "Audience": "cs"
  },
  "Auth": {
    "Enable": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
