<Page x:Class="BotFace.Pages.Register.Register_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BotFace.Pages.Register"
      mc:Ignorable="d"
      d:DesignHeight="450"
        d:DesignWidth="800"
      Title="Register_View">

    <!--Page级别淡入动画-->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid Background="Transparent">
        <Border x:Name="RootBorder"
                Opacity="0"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                MaxWidth="900"
                MinWidth="600"
                Width="Auto"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="10"
                BorderBrush="Gray">
            <!--定义6行，第3行为输入框-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--输入框行-->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- fish 图标，位于标题上方 -->
                <Border Grid.Row="1"
                        Padding="4"
                        CornerRadius="7"
                        Background="#1A1A1A"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Viewbox Width="32"
                            Height="32"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Canvas Width="256"
                                Height="256">
                            <Path Fill="White"
                                    Data="M168,76a12,12,0,1,1-12-12A12,12,0,0,1,168,76Zm42,79.08c-15.08,20.84-37.53,34.88-66.7,41.74-20.08,4.72-43.54,6-70.12,3.93q2.4,17.82,6.72,37.54a8,8,0,0,1-6.1,9.52,7.81,7.81,0,0,1-1.72.19,8,8,0,0,1-7.81-6.29q-4.89-22.36-7.41-42.62-20.22-2.51-42.58-7.41a8,8,0,0,1,3.43-15.63q19.7,4.32,37.5,6.73c-2.09-26.56-.78-50,3.93-70.06C66,83.55,80.05,61.1,100.88,46,115,35.76,140.15,23.64,179.27,24c21.19.21,40.83,4.33,43.81,6.08a8,8,0,0,1,2.83,2.83c1.75,3,5.87,22.59,6.08,43.78C232.21,98.31,228.57,129.44,210,155.08Zm-23.76,2.8A112.07,112.07,0,0,1,98.12,69.74C75.64,94,66.7,132.47,71.36,184.6,123.51,189.28,162,180.35,186.25,157.88ZM212.44,43.56a175.75,175.75,0,0,0-39.22-3.51c-24.34.64-44.71,6.49-60.76,17.39a96,96,0,0,0,86.09,86.1c10.91-16,16.76-36.42,17.4-60.76A175.82,175.82,0,0,0,212.44,43.56Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- 标题 -->
                <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                    <TextBlock Text="创建新账号"
                            FontFamily="Comic Sans MS"
                            FontSize="24"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!--注册输入框-->
                <StackPanel Grid.Row="3"
                        Margin="80,40,80,0"
                        HorizontalAlignment="Stretch">
                    <Label Content="昵称"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <TextBox Text="{Binding NameRegister}"/>
                    <Label Content="密码"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="PasswordInput"/>
                    <Label Content="确认密码"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="ConfirmPasswordInput"/>
                </StackPanel>

                <!--注册按钮-->
                <Button Grid.Row="4"
                        Content="注册"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Cursor="Hand"
                        Command="{Binding RegisterCommand}"/>

                <!--已有关联登录-->
                <TextBlock Grid.Row="5"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right">
                    <Span Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">已有账号?<Hyperlink Command="{Binding GoLoginCommand}">点击登录</Hyperlink></Span>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
